{
    "ConnectionStrings":  {
                              "DefaultConnection":  "Server=(localdb)\\MSSQLLocalDB;Database=GymShopDb;Trusted_Connection=True;TrustServerCertificate=True"
                          },
    "Jwt":  {
                "Issuer":  "GymShop.Api",
                "Audience":  "GymShop.Client",
                "Secret":  "SET_WITH_USER_SECRETS_OR_ENVIRONMENT",
                "ExpirationMinutes":  10080
            },
    "Cors":  {
                 "AllowedOrigins":  [
                                        "http://localhost:5173",
                                        "http://127.0.0.1:5173"
                                    ]
             },
    "SeedSuperAdmin":  {
                           "Email":  "admin@gymshop.com",
                           "Password":  "",
                           "Name":  "Super Admin"
                       },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "DatabaseInitialization": {
                                      "Enabled": false
                                  },
    "Https": {
                   "RedirectEnabled": true
               },
    "GoogleAuth": {
                       "ClientId": ""
                   },
    "Payments":  {
                     "CreatingTimeoutSeconds":  300
                 },
    "RateLimiting": {
                         "Enabled": true,
                         "LoginIp": { "PermitLimit": 10, "WindowSeconds": 60 },
                         "LoginAccount": { "PermitLimit": 5, "WindowSeconds": 900 },
                         "RegistrationIp": { "PermitLimit": 5, "WindowSeconds": 3600 },
                         "RegistrationGlobal": { "PermitLimit": 100, "WindowSeconds": 3600 },
                         "PasswordResetAccount": { "PermitLimit": 5, "WindowSeconds": 900 },
                         "PaymentUser": { "PermitLimit": 10, "WindowSeconds": 60 },
                         "PaymentOrder": { "PermitLimit": 3, "WindowSeconds": 60 },
                         "WebhookIp": { "PermitLimit": 120, "WindowSeconds": 60 },
                         "WebhookGlobal": { "PermitLimit": 3000, "WindowSeconds": 60 }
                     },
    "ReverseProxy": {
                         "Enabled": false,
                         "ForwardLimit": 1,
                         "KnownProxies": []
                     },
    "MercadoPago":  {
                        "Enabled":  false,
                        "AccessToken":  "",
                        "PublicKey":  "",
                        "WebhookSecret":  "",
                        "NotificationUrl":  "",
                        "SuccessUrl":  "http://localhost:5173/orders/{orderId}/payment/success",
                        "FailureUrl":  "http://localhost:5173/orders/{orderId}/payment/failure",
                        "PendingUrl":  "http://localhost:5173/orders/{orderId}/payment/pending",
                        "UseSandboxInitPoint":  true
                    }
}
