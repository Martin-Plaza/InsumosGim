<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GymShop.Application\GymShop.Application.csproj" />
    <ProjectReference Include="..\GymShop.Domain\GymShop.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retain the former SQL Server migrations as documentation, but do not compile them. -->
    <Compile Remove="Data\Migrations\**\*.cs" />
    <!-- EF updates this snapshot when creating future PostgreSQL migrations. -->
    <Compile Include="Data\Migrations\GymShopDbContextModelSnapshot.cs" />
  </ItemGroup>

</Project>
